---
import Base from '../layouts/Base.astro';
import Cartao from '../components/Cartao.astro';
import Icone from '../components/Icone.astro';
import { home, paragrafos, whatsappLink } from '../lib/dados';
---
<Base>
  <section class="carrossel" aria-roledescription="carrossel" aria-label="Destaques">
    <div class="carrossel__trilho" tabindex="0">
      {home.destaques.map((d, i) => (
        <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} de ${home.destaques.length}: ${d.titulo}`} data-indice={i}>
          {d.video
            ? <video class="slide__fundo" src={d.video} poster={d.poster} muted loop playsinline preload={i === 0 ? 'auto' : 'none'} aria-hidden="true" {...(i === 0 ? { autoplay: true } : {})}></video>
            : d.poster && <img class="slide__fundo" src={d.poster} alt="" />}
          <div class="container slide__conteudo">
            <div class="slide__texto">
              <span class="slide__numero">{String(i + 1).padStart(2, '0')} <small>/ {String(home.destaques.length).padStart(2, '0')}</small></span>
              <h2 class="slide__titulo">{d.titulo}</h2>
              <a class="botao botao--primario" href={d.link}>Saiba mais <Icone nome="seta-direita" /></a>
            </div>
            {d.imagens.length > 0 && (
              <div class="slide__fotos galeria">
                {d.imagens.map((im) => (
                  <a href={im.imagem} data-lightbox-src={im.imagem} data-legenda={`${im.rotulo} · ${im.categoria}`} class="slide__foto">
                    <img src={im.imagem} alt={`${d.titulo}: ${im.rotulo}`} loading="lazy" />
                    <span><strong>{im.rotulo}</strong><small>{im.categoria}</small></span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    {home.destaques.length > 1 && (
      <div class="carrossel__controles">
        <button class="carrossel__seta" data-dir="-1" aria-label="Destaque anterior">‹</button>
        <div class="carrossel__pontos" role="tablist" aria-label="Escolher destaque">
          {home.destaques.map((d, i) => (
            <button class="carrossel__ponto" role="tab" aria-label={d.titulo} aria-selected={i === 0 ? 'true' : 'false'} data-ir={i}><span></span></button>
          ))}
        </div>
        <button class="carrossel__seta" data-dir="1" aria-label="Próximo destaque">›</button>
      </div>
    )}
  </section>

  <script>
    const raiz = document.querySelector<HTMLElement>('.carrossel');
    const trilho = raiz?.querySelector<HTMLElement>('.carrossel__trilho');
    if (raiz && trilho) {
      const slides = Array.from(trilho.querySelectorAll<HTMLElement>('.slide'));
      const pontos = Array.from(raiz.querySelectorAll<HTMLButtonElement>('.carrossel__ponto'));
      const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const INTERVALO = 8000;
      let atual = 0;
      let timer: number | undefined;
      let pausadoPeloUsuario = false;

      const tocar = (i: number) => {
        slides.forEach((s, k) => {
          const v = s.querySelector('video');
          if (!v) return;
          if (k === i) { v.preload = 'auto'; v.play().catch(() => {}); } else { v.pause(); }
        });
        pontos.forEach((p, k) => p.setAttribute('aria-selected', String(k === i)));
        raiz.style.setProperty('--progresso-duracao', `${INTERVALO}ms`);
        raiz.classList.remove('carrossel--anima'); void raiz.offsetWidth;
        if (!pausadoPeloUsuario && !semMovimento) raiz.classList.add('carrossel--anima');
      };
      const ir = (i: number, suave = true) => {
        atual = (i + slides.length) % slides.length;
        trilho.scrollTo({ left: slides[atual].offsetLeft, behavior: suave && !semMovimento ? 'smooth' : 'auto' });
      };
      const agendar = () => {
        clearInterval(timer);
        if (pausadoPeloUsuario || semMovimento || slides.length < 2) return;
        timer = window.setInterval(() => ir(atual + 1), INTERVALO);
      };
      const pararAuto = () => { pausadoPeloUsuario = true; clearInterval(timer); raiz.classList.remove('carrossel--anima'); };

      // Detecta o slide visível pela posição da rolagem (setas, pontos, dedo ou trackpad)
      let visivel = -1;
      const atualizar = () => {
        const i = Math.round(trilho.scrollLeft / trilho.clientWidth);
        if (i === visivel || i < 0 || i >= slides.length) return;
        visivel = i; atual = i; tocar(i); agendar();
      };
      let espera: number | undefined;
      trilho.addEventListener('scroll', () => { clearTimeout(espera); espera = window.setTimeout(atualizar, 120); }, { passive: true });
      atualizar();

      raiz.querySelectorAll<HTMLButtonElement>('.carrossel__seta').forEach((b) =>
        b.addEventListener('click', () => { pararAuto(); ir(atual + Number(b.dataset.dir)); }));
      pontos.forEach((p) => p.addEventListener('click', () => { pararAuto(); ir(Number(p.dataset.ir)); }));
      trilho.addEventListener('pointerdown', pararAuto, { passive: true });
      trilho.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) pararAuto(); }, { passive: true });
      trilho.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); pararAuto(); ir(atual + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); pararAuto(); ir(atual - 1); }
      });
      // Pausa quando a aba fica oculta ou o carrossel sai da tela
      document.addEventListener('visibilitychange', () => {
        const v = slides[atual].querySelector('video');
        if (document.hidden) { clearInterval(timer); v?.pause(); } else { v?.play().catch(() => {}); agendar(); }
      });
      new IntersectionObserver(([e]) => {
        const v = slides[atual].querySelector('video');
        if (e.isIntersecting) { v?.play().catch(() => {}); agendar(); } else { v?.pause(); clearInterval(timer); }
      }).observe(raiz);
      // Ao redimensionar, mantém o slide atual alinhado
      addEventListener('resize', () => ir(atual, false));
    }
  </script>

  <section class="intro container">
    <p class="sobretitulo">inMetal · Produtos em Aço</p>
    <h1>{home.intro_titulo}</h1>
    <div class="intro__texto">{paragrafos(home.intro_texto).map((p) => <p>{p}</p>)}</div>
    <div class="intro__botoes">
      <a class="botao botao--primario" href={whatsappLink()} target="_blank" rel="noopener"><Icone nome="whatsapp" /> Pedir orçamento</a>
      <a class="botao botao--contorno" href="/empresa/">Conheça a empresa</a>
    </div>
  </section>

  <section class="secao secao--cinza" id="servicos">
    <div class="container">
      <header class="secao__cabeca">
        <p class="sobretitulo">O que fazemos</p>
        <h2>{home.servicos_titulo}</h2>
      </header>
      <div class="grade grade--4">
        {home.servicos.map((c) => <Cartao {...c} />)}
      </div>
    </div>
  </section>

  <section class="secao" id="produtos">
    <div class="container">
      <header class="secao__cabeca">
        <p class="sobretitulo">O que fabricamos</p>
        <h2>{home.produtos_titulo}</h2>
      </header>
      <div class="grade grade--3">
        {home.produtos.map((c) => <Cartao {...c} />)}
      </div>
    </div>
  </section>

  {home.catalogo && (
    <section class="secao secao--escura" id="catalogo">
      <div class="container catalogo-home">
        <a class="catalogo-home__capa" href={home.catalogo.arquivo} target="_blank" rel="noopener" aria-label={home.catalogo.botao}>
          <img src={home.catalogo.capa} alt={`Capa do ${home.catalogo.titulo}`} loading="lazy" width="455" height="644" />
        </a>
        <div>
          <p class="sobretitulo sobretitulo--claro">Material para download</p>
          <h2>{home.catalogo.titulo}</h2>
          {paragrafos(home.catalogo.texto).map((p) => <p>{p}</p>)}
          <div class="catalogo-home__botoes">
            <a class="botao botao--primario" href={home.catalogo.arquivo} target="_blank" rel="noopener"><Icone nome="pdf" /> {home.catalogo.botao}</a>
            <a class="botao botao--contorno-claro" href={whatsappLink('Olá! Vi o catálogo da inMetal e gostaria de um orçamento.')} target="_blank" rel="noopener"><Icone nome="whatsapp" /> Pedir orçamento</a>
          </div>
        </div>
      </div>
    </section>
  )}
</Base>
